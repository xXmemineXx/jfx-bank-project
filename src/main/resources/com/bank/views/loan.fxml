                                    <Image url="@../icons/icons8-mail-24.png" />
                                 </image>
                              </ImageView>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="79.0" prefWidth="74.0" HBox.hgrow="ALWAYS">
