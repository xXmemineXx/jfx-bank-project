                                          <Image url="@../icons/icons8-trash-64.png" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER" onMouseClicked="#handleEdit" prefHeight="200.0" prefWidth="100.0" styleClass="menu-option">
                                 <children>
                                    <ImageView fitHeight="36.0" fitWidth="30.0">
